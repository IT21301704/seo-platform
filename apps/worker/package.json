{
  "name": "@seo/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./queue": "./src/queue.ts",
    "./progress": "./src/progress.ts",
    "./storage": "./src/storage.ts",
    "./crawls": "./src/crawls.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "seed": "tsx src/seed.ts",
