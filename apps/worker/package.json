    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@seo/crawler": "workspace:*",
    "@seo/db": "workspace:*",
    "@seo/llm": "workspace:*",
    "@seo/rules": "workspace:*",
    "@seo/scoring": "workspace:*",
    "@seo/shared": "workspace:*",
    "bullmq": "catalog:",
    "ioredis": "catalog:",
    "yauzl": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/yauzl": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
