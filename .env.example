# Copy to .env and fill in. Never commit real values.
# Values below are local-only defaults that match docker-compose.yml.

POSTGRES_USER=seo
POSTGRES_PASSWORD=seo_local_only
POSTGRES_DB=seo_platform
POSTGRES_PORT=5433
DATABASE_URL=postgresql://seo:seo_local_only@localhost:5433/seo_platform

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=snapshots
S3_ACCESS_KEY_ID=minio_local
S3_SECRET_ACCESS_KEY=minio_local_only

WORDPRESS_DB_PASSWORD=wp_local_only
WORDPRESS_PORT=8088

# Secrets: leave empty locally until needed.
ANTHROPIC_API_KEY=
LLM_MODEL_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PSI_API_KEY=
# 32 bytes, used to encrypt OAuth tokens, webhook and Slack secrets at rest: openssl rand -hex 32
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# Public base URL of the web app (OAuth redirect, links in emails and webhooks)
APP_URL=http://localhost:3000

# Local development options (never enable in production)
# AUTH_DEV_LOGIN=true   -> sign in as a seeded user without email (dev + e2e only)
# FIXTURE_SITES=true    -> audits of example-store.com read fixtures/ instead of the network
# FIXTURE_SITE_NAME=golden-site
AUTH_DEV_LOGIN=
FIXTURE_SITES=
EMAIL_SERVER=
EMAIL_FROM=
