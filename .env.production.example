# Copy to .env.production on the server and fill in. Never commit real values.
# Generate secrets with: openssl rand -hex 32

# Public hostname (DNS A record must point at this server). Caddy gets the TLS certificate.
DOMAIN=seo.example.com
APP_URL=https://seo.example.com

# Postgres (internal to the Docker network)
POSTGRES_USER=seo
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=seo_platform
DATABASE_URL=postgresql://seo:change-me-long-random@postgres:5432/seo_platform

REDIS_URL=redis://redis:6379

# Object storage. Defaults use the bundled SeaweedFS service; swap for AWS S3 / R2 if preferred.
S3_ENDPOINT=http://s3:8333
S3_REGION=us-east-1
S3_BUCKET=snapshots
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me-long-random

# Required secrets
AUTH_SECRET=
# 32 bytes hex — encrypts OAuth tokens, webhook and Slack secrets. Back it up: losing it
# makes stored tokens unreadable.
ENCRYPTION_KEY=

# Sign-in emails (magic links). Without EMAIL_SERVER the link is printed to `docker compose logs web`.
# Format: smtp://user:password@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=SEO Platform <no-reply@seo.example.com>

# Optional integrations
ANTHROPIC_API_KEY=
LLM_MODEL_ID=
# Google OAuth redirect URI: https://<DOMAIN>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PSI_API_KEY=

# Tuning
WORKER_CONCURRENCY=2
LLM_MAX_CALLS_PER_AUDIT=30

# Never set these in production: AUTH_DEV_LOGIN, FIXTURE_SITES, DEV_ALLOW_PRIVATE_HOSTS
